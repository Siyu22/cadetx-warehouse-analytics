import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os

plt.style.use('seaborn-v0_8')

# %%
# Load all datasets
data_files = {
    "branches": "branches.csv",
    "customers": "customers.csv",
    "inventory_master": "inventory_master.csv",
    "invoices": "invoices.csv",
    "payments": "payments.csv",
    "products": "products.csv",
    "purchase_orders_header": "purchase_orders_header.csv",
    "purchase_orders_lines": "purchase_orders_lines.csv",
    "sales_orders_header": "sales_orders_header.csv",
    "sales_orders_lines": "sales_orders_lines.csv",
    "stock_ledger": "stock_ledger.csv",
    "suppliers": "suppliers.csv"
}

df_dict = {}
for name, fp in data_files.items():
    df = pd.read_csv(fp)
    df_dict[name] = df
    print(f"\n===== {name} =====")
    print(f"Shape: {df.shape}")
    print(df.dtypes)
    print("Null counts:")
    print(df.isnull().sum())
    print(df.describe())

# %%
# Date range check on stock ledger
ledger = df_dict["stock_ledger"]
ledger["transaction_date"] = pd.to_datetime(ledger["transaction_date"], errors="coerce")
print("Stock ledger date range:")
print(ledger["transaction_date"].min(), "to", ledger["transaction_date"].max())

# %%
# Quick check inventory master stock vs max stock
inv = df_dict["inventory_master"]
print("current_stock stats")
print(inv["current_stock"].describe())
print("max_stock stats")
print(inv["max_stock"].describe())
print("reorder_point stats")
print(inv["reorder_point"].describe())

# %%
# Save summary output for sprint review
summary = []
for tbl, d in df_dict.items():
    summary.append({"table":tbl, "rows":d.shape[0], "cols":d.shape[1]})
pd.DataFrame(summary).to_csv("table_summary.csv", index=False)
